---
import { site } from '../site.config';
---

<svg
  class="wordmark"
  viewBox="0 0 280 38"
  width="280"
  height="38"
  role="img"
  aria-label={site.name}
>
  <title>{site.name}</title>
  <text
    x="0"
    y="29"
    fill="currentColor"
    font-family="Arial, Liberation Sans, Helvetica, sans-serif"
    font-size="29"
    font-weight="700"
    letter-spacing="-0.75">{site.name}</text
  >
</svg>
