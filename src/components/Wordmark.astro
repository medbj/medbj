---
import { site } from '../site.config';
const words = site.name.trim().split(/\s+/);
const topLine = words[0] || site.name;
const bottomLine = words.slice(1).join(' ');
const topSize = Math.min(32, 168 / (Math.max(topLine.length, 1) * 0.7));
const bottomSize = Math.min(27, 168 / (Math.max(bottomLine.length, 1) * 0.6));
---

<svg
  class="wordmark"
  viewBox="0 0 180 70"
  width="180"
  height="70"
  role="img"
  aria-label={site.name}
>
  <title>{site.name}</title>
  <text
    x="0"
    y={bottomLine ? 29 : 46}
    fill="currentColor"
    font-family="Arial, Liberation Sans, Helvetica, sans-serif"
    font-size={topSize}
    font-weight="700"
    letter-spacing="-0.6">{topLine}</text
  >
  {
    bottomLine && (
      <text
        x="0"
        y="61"
        fill="currentColor"
        font-family="Arial, Liberation Sans, Helvetica, sans-serif"
        font-size={bottomSize}
        font-weight="700"
        letter-spacing="-0.65"
      >
        {bottomLine}
      </text>
    )
  }
</svg>
