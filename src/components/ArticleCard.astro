---
import Icon from './Icon.astro';
import type { Article } from '../lib/content';
import { articleUrl, readTime } from '../lib/content';
import { categoryFor } from '../lib/taxonomy';
import { Image } from 'astro:assets';
import Art from './Art.astro';
interface Props {
  article: Article;
  compact?: boolean;
}
const { article, compact = false } = Astro.props;
const category = categoryFor(article);
---

<article class:list={['article-card', { compact }]}>
  <a
    class="article-art-link"
    href={articleUrl(article)}
    tabindex="-1"
    aria-hidden="true"
  >
    {
      article.data.image ? (
        <Image
          class="article-card-cover"
          src={article.data.image}
          alt={article.data.imageAlt || ''}
          widths={[320, 640, 960]}
          sizes="(min-width: 1000px) 360px, (min-width: 600px) 50vw, 100vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      ) : article.data.cover ? (
        <img
          class="article-card-cover"
          src={article.data.cover.src}
          alt={article.data.cover.alt}
          width={article.data.cover.width}
          height={article.data.cover.height}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Art kind={article.data.visual} />
      )
    }
  </a>
  <div class="article-card-body">
    <div class="eyebrow">
      <a href={`/categories/${category.slug}/`}>{category.name}</a><span>·</span
      ><span>{readTime(article)} min read</span>
    </div>
    <h3><a href={articleUrl(article)}>{article.data.title}</a></h3>
    <p>{article.data.description}</p>
    <a
      class="text-link"
      href={articleUrl(article)}
      aria-label={`Read article: ${article.data.title}`}
      >Read article <Icon name="external" /></a
    >
  </div>
</article>

<style>
  .article-card-cover {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1.65;
    object-fit: cover;
  }
</style>
