---
import Icon from './Icon.astro';
import type { Article } from '../lib/content';
import { articleUrl, readTime } from '../lib/content';
import { topicBySlug } from '../lib/topics';
import Art from './Art.astro';
interface Props {
  article: Article;
  compact?: boolean;
}
const { article, compact = false } = Astro.props;
---

<article class:list={['article-card', { compact }]}>
  <a
    class="article-art-link"
    href={articleUrl(article)}
    tabindex="-1"
    aria-hidden="true"><Art kind={article.data.visual} /></a
  >
  <div class="article-card-body">
    <div class="eyebrow">
      <a href={`/topics/${article.data.topic}/`}
        >{topicBySlug(article.data.topic).name}</a
      ><span>·</span><span>{readTime(article)} min read</span>
    </div>
    <h3><a href={articleUrl(article)}>{article.data.title}</a></h3>
    <p>{article.data.description}</p>
    <a
      class="text-link"
      href={articleUrl(article)}
      aria-label={`Read article: ${article.data.title}`}
      >Read article <Icon name="external" /></a
    >
  </div>
</article>
