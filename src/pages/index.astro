---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import HomePaths from '../components/HomePaths.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { articles } from '../lib/content';
import { topics } from '../lib/topics';
import { site } from '../site.config';
import { mediaAvailable } from '../lib/media';
const latest = (await articles()).slice(0, 3);
const showMedia = await mediaAvailable();
---

<Base title="Psychology for everyday life" description={site.description}>
  <div class="container home-layout">
    <HomeHero />
    <div class="home-principles">
      <span><Icon name="book" /> Plain language</span><span
        ><Icon name="leaf" /> Different experiences welcome</span
      ><span><Icon name="heart" /> At your pace, always</span>
    </div>
    <HomePaths />
    <section class="home-section home-reads" aria-labelledby="latest-heading">
      <div class="section-head">
        <div>
          <p class="eyebrow">Something to sit with</p><h2 id="latest-heading">
            A fresh perspective.
          </h2>
        </div><a class="text-link" href="/blog/"
          >Explore all articles <Icon name="arrow" /></a
        >
      </div>
      <div class="article-grid">
        {latest.map((article) => <ArticleCard article={article} compact />)}
      </div>
      {
        latest.some((article) => article.data.sample) && (
          <p class="home-sample-note">
            Sample articles, awaiting human editorial review.{' '}
            <a href="/editorial-policy/">Read our editorial approach.</a>
          </p>
        )
      }
    </section>
    <section class="home-section home-topics" aria-labelledby="topics-heading">
      <div class="centered-heading">
        <p class="eyebrow">Follow your curiosity</p><h2 id="topics-heading">
          Room for all of it.
        </h2><p>
          Everyday feelings, familiar questions, and the things we’re still
          figuring out.
        </p>
      </div>
      <div class="home-topic-grid">
        {
          topics.map((topic) => (
            <a class="home-topic-card" href={`/topics/${topic.slug}/`}>
              <>
                <div>
                  <>
                    <h3>{topic.name}</h3>
                    <p>{topic.description}</p>
                  </>
                </div>
                <span class="round-arrow">
                  <Icon name="external" />
                </span>
              </>
            </a>
          ))
        }
      </div>
      <div class="section-bottom">
        <a class="text-link" href="/topics/"
          >See every topic <Icon name="arrow" /></a
        >
      </div>
    </section>
    <section class="reflection-panel" aria-labelledby="reflection-heading">
      <div class="reflection-disc">
        <p class="eyebrow">A pause, whenever you need it</p><h2
          id="reflection-heading"
        >
          You don’t need all the answers to begin.
        </h2><p>
          Read a little. Follow your curiosity. Leave room for your own
          experience.
        </p><a class="button" href="/start-here/"
          >Find your next read <Icon name="arrow" /></a
        >
      </div>
    </section>
    <section class="home-section home-newsletter" aria-label="Newsletter">
      <Newsletter />
    </section>
    {
      showMedia && (
        <section class="home-section media-home-panel">
          <>
            <div>
              <>
                <p class="eyebrow">Listen &amp; Watch</p>
                <h2>A different way to take it in.</h2>
                <p>
                  Thoughtful conversations and short videos, with descriptions
                  and reading alternatives.
                </p>
                <p class="fine-print">
                  Sample collection. Real episodes and platform links are coming
                  later.
                </p>
              </>
            </div>
            <a class="button secondary" href="/listen-and-watch/">
              Explore Listen &amp; Watch <Icon name="headphones" />
            </a>
          </>
        </section>
      )
    }
  </div>
</Base>
