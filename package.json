{
  "name": "mena-psychology",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "npm run check:content && npm run check:contrast && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/generate-headers.mjs && pagefind --site dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "test:guards": "node scripts/check-content.test.mjs",
    "test:checks": "npm run test:guards"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.6.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
