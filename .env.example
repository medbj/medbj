# Public build-time settings. Rebuild after changing these values.
# Replace with the canonical HTTPS origin of your production deployment.
SITE_URL=https://example.com

# Leave empty until a real newsletter provider has been configured.
# Use a public HTTPS subscription endpoint, never an API key.
PUBLIC_NEWSLETTER_ACTION_URL=
PUBLIC_NEWSLETTER_EMAIL_FIELD=email
PUBLIC_NEWSLETTER_HONEYPOT_FIELD=website

# Optional cookieless analytics. Leave all empty to send no analytics requests.
# Configure one provider only, and update /privacy before enabling it.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=
