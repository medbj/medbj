# Build-time configuration. Rebuild after changing these values.
# Leave blank for the configured private review origin.
# Public launch requires the final HTTPS origin, without a path or trailing slash.
SITE_URL=

# Use a real provider's public HTTPS form endpoint, never an API key.
# Leave the action blank while signup is unavailable in the review build.
PUBLIC_NEWSLETTER_ACTION_URL=
# Verify these field names against the provider; defaults are not provider approval.
PUBLIC_NEWSLETTER_EMAIL_FIELD=email
PUBLIC_NEWSLETTER_HONEYPOT_FIELD=website
# Set to true only after a human confirms a real signup and provider-side double opt-in.
PUBLIC_NEWSLETTER_DOUBLE_OPT_IN_CONFIRMED=false

# Human attestations for the public launch gate. These do not perform a review.
# Set true only after the actual review/process is complete and copy matches reality.
LEGAL_REVIEW_CONFIRMED=false
EDITORIAL_PROCESS_CONFIRMED=false

# Optional cookieless analytics. Leave all empty for no analytics requests.
# Configure one provider only; verify its privacy settings before enabling it.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=
